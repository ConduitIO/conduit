# Environment for the conduit.service example. Keep this file mode 0640, group
# conduit. Names only: put real values here on the host, never in version control.
#
# Any `conduit run` flag has a CONDUIT_* variable (CONDUIT_API_HTTP_ADDRESS, ...).
# The API is unauthenticated: bind it to loopback unless a proxy in front
# authenticates callers.
CONDUIT_API_HTTP_ADDRESS=127.0.0.1:8080
CONDUIT_API_GRPC_ADDRESS=127.0.0.1:8084
CONDUIT_LOG_LEVEL=info

# For a Postgres state store instead of the local badger database, change
# --db.type in the unit to postgres and set:
# CONDUIT_DB_POSTGRES_CONNECTION_STRING=
