{
  "suite": "pg-reshape",
  "description": "Reshaping SMTs after the unwrap, over real Debezium Postgres output: a defaulted nullable column, jsonb, TOAST, dotted and Kelvin-sign names, rename swaps, and InsertField onto an existing field.",
  "recordType": "source",
  "recordsFrom": "debezium-postgres.json",
  "runs": [
    {"run": "flatten", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "f", "type": "Flatten$Value", "config": {}}]},
    {"run": "flatten-underscore", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "f", "type": "Flatten$Value", "config": {"delimiter": "_"}}]},
    {"run": "hoist", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "h", "type": "HoistField$Value", "config": {"field": "row"}}]},
    {"run": "exclude", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "r", "type": "ReplaceField$Value", "config": {"exclude": "big,attrs", "replace.null.with.default": "false"}}]},
    {"run": "rename-swap", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "r", "type": "ReplaceField$Value", "config": {"renames": "a:b,b:a", "replace.null.with.default": "false"}}]},
    {"run": "rename-swap-default-true", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "r", "type": "ReplaceField$Value", "config": {"renames": "a:b,b:a"}}]},
    {"run": "rename-defaulted-column-false", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "r", "type": "ReplaceField$Value", "config": {"renames": "note:remark", "replace.null.with.default": "false"}}]},
    {"run": "rename-defaulted-column-true", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "r", "type": "ReplaceField$Value", "config": {"renames": "note:remark", "replace.null.with.default": "true"}}]},
    {"run": "insert-static-new", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "i", "type": "InsertField$Value", "config": {"static.field": "src", "static.value": "pg", "replace.null.with.default": "false"}}]},
    {"run": "insert-static-onto-existing", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "i", "type": "InsertField$Value", "config": {"static.field": "name", "static.value": "overwritten", "replace.null.with.default": "false"}}]},
    {"run": "insert-static-onto-defaulted-existing", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "i", "type": "InsertField$Value", "config": {"static.field": "note", "static.value": "overwritten", "replace.null.with.default": "false"}}]},
    {"run": "insert-topic", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "i", "type": "InsertField$Value", "config": {"topic.field": "t", "replace.null.with.default": "false"}}]},
    {"run": "extract-field-string", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "e", "type": "ExtractField$Value", "config": {"field": "name", "replace.null.with.default": "false"}}]},
    {"run": "extract-field-string-default-true", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "e", "type": "ExtractField$Value", "config": {"field": "note"}}]},
    {"run": "extract-field-string-default-false", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "e", "type": "ExtractField$Value", "config": {"field": "note", "replace.null.with.default": "false"}}]},
    {"run": "value-to-key", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "v", "type": "ValueToKey", "config": {"fields": "name", "replace.null.with.default": "false"}}]},
    {"run": "value-to-key-two-fields", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}, {"alias": "v", "type": "ValueToKey", "config": {"fields": "id,name", "replace.null.with.default": "false"}}]},
    {"run": "regexrouter-alternation", "chain": [{"alias": "r", "type": "RegexRouter", "config": {"regex": "dbz\\.public\\.(a|ab)", "replacement": "x-$1"}}, {"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}]},
    {"run": "regexrouter-lazy", "chain": [{"alias": "r", "type": "RegexRouter", "config": {"regex": "dbz\\.public\\.a.*?", "replacement": "x"}}, {"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}]},
    {"run": "regexrouter-table-to-topic", "chain": [{"alias": "r", "type": "RegexRouter", "config": {"regex": "dbz\\.public\\.(.*)", "replacement": "cdc.$1"}}, {"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {"replace.null.with.default": "false"}}]},
    {"run": "flatten-enrs-null-default", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {}}, {"alias": "f", "type": "Flatten$Value", "config": {}}]},
    {"run": "hoist-enrs-null-default", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {}}, {"alias": "h", "type": "HoistField$Value", "config": {"field": "row"}}]},
    {"run": "rename-swap-enrs-null-default", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {}}, {"alias": "r", "type": "ReplaceField$Value", "config": {"renames": "a:b,b:a", "replace.null.with.default": "false"}}]},
    {"run": "exclude-enrs-null-default", "chain": [{"alias": "unwrap", "type": "io.debezium.transforms.ExtractNewRecordState", "config": {}}, {"alias": "r", "type": "ReplaceField$Value", "config": {"exclude": "big,attrs", "replace.null.with.default": "false"}}]}
  ]
}
