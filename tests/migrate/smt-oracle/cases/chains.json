  "runs": [
    {"run": "insert-if-topic-matches", "chain": [{"alias": "c", "type": "InsertField$Value", "config": {"static.field": "tag", "static.value": "x"}, "predicate": "p"}], "predicates": {"p": {"type": "TopicNameMatches", "config": {"pattern": "orders-.*"}}}},
    {"run": "insert-if-topic-matches-negate", "chain": [{"alias": "c", "type": "InsertField$Value", "config": {"static.field": "tag", "static.value": "x"}, "predicate": "p", "negate": true}], "predicates": {"p": {"type": "TopicNameMatches", "config": {"pattern": "orders-.*"}}}},
    {"run": "drop-tombstones-then-flatten-then-exclude", "chain": [{"alias": "d", "type": "Filter", "config": {}, "predicate": "t"}, {"alias": "f", "type": "Flatten$Value", "config": {"delimiter": "_"}}, {"alias": "e", "type": "ReplaceField$Value", "config": {"exclude": "s"}}], "predicates": {"t": {"type": "RecordIsTombstone", "config": {}}}},
    {"run": "router-then-topic-predicate", "chain": [{"alias": "r", "type": "RegexRouter", "config": {"regex": "orders-(\\d+)", "replacement": "o$1"}}, {"alias": "c", "type": "InsertField$Value", "config": {"static.field": "tag", "static.value": "x"}, "predicate": "p"}], "predicates": {"p": {"type": "TopicNameMatches", "config": {"pattern": "o\\d+"}}}},
    {"run": "router-then-insert-topic", "chain": [{"alias": "r", "type": "RegexRouter", "config": {"regex": "orders-(\\d+)", "replacement": "o$1"}}, {"alias": "i", "type": "InsertField$Value", "config": {"topic.field": "t"}}]},
    {"run": "insert-then-value-to-key", "chain": [{"alias": "i", "type": "InsertField$Value", "config": {"static.field": "src", "static.value": "kc"}}, {"alias": "v", "type": "ValueToKey", "config": {"fields": "src"}}]},
    {"run": "header-predicate-negate", "chain": [{"alias": "i", "type": "InsertField$Value", "config": {"static.field": "untagged", "static.value": "yes"}, "predicate": "h", "negate": true}], "predicates": {"h": {"type": "HasHeaderKey", "config": {"name": "tenant"}}}},
    {"run": "extract-then-hoist", "chain": [{"alias": "e", "type": "ExtractField$Value", "config": {"field": "n"}}, {"alias": "h", "type": "HoistField$Value", "config": {"field": "wrapped"}}]},
    {"run": "rename-then-insert-same-name", "chain": [{"alias": "r", "type": "ReplaceField$Value", "config": {"renames": "a:b"}}, {"alias": "i", "type": "InsertField$Value", "config": {"static.field": "a", "static.value": "new"}}]},
    {"run": "error-mid-chain-stops", "chain": [{"alias": "c", "type": "ValueToKey", "config": {"fields": "absent"}}, {"alias": "i", "type": "InsertField$Value", "config": {"static.field": "after", "static.value": "cast"}}]},
    {"run": "two-predicates", "chain": [{"alias": "c", "type": "InsertField$Value", "config": {"static.field": "tag", "static.value": "x"}, "predicate": "p1"}, {"alias": "i", "type": "InsertField$Value", "config": {"static.field": "audited", "static.value": "y"}, "predicate": "p2"}], "predicates": {"p1": {"type": "TopicNameMatches", "config": {"pattern": "orders-.*"}}, "p2": {"type": "TopicNameMatches", "config": {"pattern": "audit-.*"}}}},
