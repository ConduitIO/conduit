# Environment variables the migrated pipelines reference. migrate never writes their values.

# shop-cdc: database.password (connector.json#/config/database.password)
KC_SHOP_CDC_DATABASE_PASSWORD=

# shop-cdc: tables (required by builtin:postgres (source))
KC_SHOP_CDC_SOURCE_TABLES=

# shop-cdc: servers (required by builtin:kafka (destination))
KC_SHOP_CDC_DESTINATION_SERVERS=
