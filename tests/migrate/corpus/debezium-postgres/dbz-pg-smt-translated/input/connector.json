{
    "name": "orders-cdc",
    "config": {
        "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
        "tasks.max": "1",
        "plugin.name": "pgoutput",
        "database.hostname": "postgres.internal.example",
        "database.port": "5432",
        "database.user": "postgres",
        "database.password": "PLACEHOLDER_SECRET_DB_PASSWORD",
        "database.dbname": "orders",
        "topic.prefix": "shop",
        "table.include.list": "public.orders,public.order_lines",
        "key.converter": "org.apache.kafka.connect.json.JsonConverter",
        "key.converter.schemas.enable": "false",
        "key.converter.replace.null.with.default": "false",
        "value.converter": "org.apache.kafka.connect.json.JsonConverter",
        "value.converter.schemas.enable": "false",
        "value.converter.replace.null.with.default": "false",
        "transforms": "route,unwrap,dropDeletes,trim",
        "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.route.regex": "shop\\.public\\.(.*)",
        "transforms.route.replacement": "cdc.$1",
        "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
        "transforms.unwrap.replace.null.with.default": "false",
        "transforms.dropDeletes.type": "org.apache.kafka.connect.transforms.Filter",
        "transforms.dropDeletes.predicate": "isTombstone",
        "transforms.trim.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.trim.exclude": "internal_notes",
        "transforms.trim.renames": "cust_id:customer_id",
        "transforms.trim.replace.null.with.default": "false",
        "transforms.trim.predicate": "isOrders",
        "predicates": "isTombstone,isOrders",
        "predicates.isTombstone.type": "org.apache.kafka.connect.transforms.predicates.RecordIsTombstone",
        "predicates.isOrders.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
        "predicates.isOrders.pattern": "cdc\\.orders"
    }
}
