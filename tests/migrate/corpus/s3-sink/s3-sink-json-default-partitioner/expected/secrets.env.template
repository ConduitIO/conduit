# Environment variables the migrated pipelines reference. migrate never writes their values.

# sink-s3-00: servers (required by builtin:kafka (source))
KC_SINK_S3_00_SOURCE_SERVERS=

# sink-s3-00: aws.accessKeyId (required by builtin:s3 (destination))
KC_SINK_S3_00_DESTINATION_AWS_ACCESSKEYID=

# sink-s3-00: aws.secretAccessKey (required by builtin:s3 (destination))
KC_SINK_S3_00_DESTINATION_AWS_SECRETACCESSKEY=

# sink-s3-00: format (required by builtin:s3 (destination))
KC_SINK_S3_00_DESTINATION_FORMAT=
