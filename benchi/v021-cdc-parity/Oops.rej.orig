+# Each is reported as ROWS_AFTER - ROWS_BEFORE, divided by 60s. See README.md
 # and bench.yml.
 #
 # Usage: benchi/v021-cdc-parity/run.sh [ROUNDS] [ARM ...]
 #   ROUNDS        number of full rounds (default 3). One warmup round is
 #                 discarded first.
