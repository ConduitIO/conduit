time=2026-10-27T00:05:16.347Z level=INFO msg="Running command in existing container" container=cdcparity-counter command="n=0\nuntil wget -q -O /dev/null http://cdcparity-connect-pg:8083/connectors 2>/dev/null; do\n  n=$((n+1))\n  if [ \"$n\" -ge 240 ]; then echo \"connect REST API never came up\"; exit 1; fi\n  sleep 1\ndone\n\nN=\"${TABLES:-1}\"\nfor i in $(seq 0 $((N-1))); do\n  t=\"bench_source_${i}\"\n  d=\"bench_dest_${i}\"\n  cat > /tmp/debezium-source-pg.json <<JSON\n{\"name\":\"debezium-pg-${i}\",\"config\":{\"connector.class\":\"io.debezium.connector.postgresql.PostgresConnector\",\"database.hostname\":\"cdcparity-postgres\",\"database.port\":\"5432\",\"database.user\":\"bench\",\"database.password\":\"bench\",\"database.dbname\":\"bench\",\"topic.prefix\":\"cdcparitypg\",\"table.include.list\":\"public.${t}\",\"plugin.name\":\"pgoutput\",\"slot.name\":\"debezium_pg_slot_${i}\",\"publication.name\":\"debezium_pg_pub_${i}\",\"publication.autocreate.mode\":\"filtered\",\"snapshot.mode\":\"never\",\"tombstones.on.delete\":\"false\",\"heartbeat.interval.ms\":\"0\",\"key.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"key.converter.schemas.enable\":\"true\",\"value.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"value.converter.schemas.enable\":\"true\",\"transforms\":\"unwrap\",\"transforms.unwrap.type\":\"io.debezium.transforms.ExtractNewRecordState\",\"transforms.unwrap.delete.tombstone.handling.mode\":\"tombstone\"}}\nJSON\n  cat > /tmp/jdbc-sink-pg.json <<JSON\n{\"name\":\"jdbc-pg-${i}\",\"config\":{\"connector.class\":\"io.confluent.connect.jdbc.JdbcSinkConnector\",\"tasks.max\":\"1\",\"topics\":\"cdcparitypg.public.${t}\",\"connection.url\":\"jdbc:postgresql://cdcparity-postgres:5432/bench\",\"connection.user\":\"bench\",\"connection.password\":\"bench\",\"table.name.format\":\"${d}\",\"insert.mode\":\"upsert\",\"pk.mode\":\"record_key\",\"pk.fields\":\"id\",\"delete.enabled\":\"true\",\"auto.create\":\"false\",\"auto.evolve\"