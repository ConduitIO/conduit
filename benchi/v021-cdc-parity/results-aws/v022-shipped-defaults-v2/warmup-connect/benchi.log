time=2026-10-27T02:25:05.723Z level=INFO msg="Running command in existing container" container=cdcparity-counter command="n=0\nuntil wget -q -O /dev/null http://cdcparity-connect:8083/connectors 2>/dev/null; do\n  n=$((n+1))\n  if [ \"$n\" -ge 240 ]; then echo \"connect REST API never came up\"; exit 1; fi\n  sleep 1\ndone\n\nN=\"${TABLES:-1}\"\nfor i in $(seq 0 $((N-1))); do\n  t=\"bench_source_${i}\"\n  cat > /tmp/debezium-source.json <<JSON\n{\"name\":\"debezium-postgres-${i}\",\"config\":{\"connector.class\":\"io.debezium.connector.postgresql.PostgresConnector\",\"database.hostname\":\"cdcparity-postgres\",\"database.port\":\"5432\",\"database.user\":\"bench\",\"database.password\":\"bench\",\"database.dbname\":\"bench\",\"topic.prefix\":\"cdcparity\",\"table.include.list\":\"public.${t}\",\"plugin.name\":\"pgoutput\",\"slot.name\":\"debezium_slot_${i}\",\"publication.name\":\"debezium_pub_${i}\",\"publication.autocreate.mode\":\"filtered\",\"snapshot.mode\":\"never\",\"tombstones.on.delete\":\"false\",\"heartbeat.interval.ms\":\"0\",\"key.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"key.converter.schemas.enable\":\"false\",\"value.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"value.converter.schemas.enable\":\"false\"}}\nJSON\n  cat > /tmp/file-sink.json <<JSON\n{\"name\":\"file-sink-${i}\",\"config\":{\"connector.class\":\"org.apache.kafka.connect.file.FileStreamSinkConnector\",\"topics\":\"cdcparity.public.${t}\",\"file\":\"/sink/out_${i}.txt\",\"tasks.max\":\"1\",\"key.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"key.converter.schemas.enable\":\"false\",\"value.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"value.converter.schemas.enable\":\"false\"}}\nJSON\n  wget -q -O- --header='Content-Type: application/json' --post-file=/tmp/debezium-source.json http://cdcparity-connect:8083/connectors\n  wget -q -O- --header='Content-Type: application/json' --post-file=/tmp/file-sink.json http://cdcparity-connect:8083/connectors\ndone\necho \"connect connectors registered (N=$N)\"\n"
