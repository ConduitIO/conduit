time=2026-10-27T02:34:34.684Z level=INFO msg="Running command in existing container" container=cdcparity-counter command="count() {\n  rm -rf /tmp/s3dump\n  aws --endpoint-url http://cdcparity-minio:9000 s3 cp --recursive s3://bench/ /tmp/s3dump --quiet 2>/dev/null || true\n  find /tmp/s3dump -type f -exec cat {} + 2>/dev/null | wc -l | tr -d ' '\n}\nn=0\nwhile [ \"$n\" -lt 180 ]; do\n  cnt=$(aws --endpoint-url http://cdcparity-minio:9000 s3api list-objects-v2 --bucket bench --max-keys 1 --query 'KeyCount' --output text 2>/dev/null || echo 0)\n  if [ \"${cnt:-0}\" -gt 0 ]; then break; fi\n  n=$((n+1))\n  sleep 1\ndone\nsleep 15\necho \"ROWS_BEFORE=$(count)\"\n"
time=2026-10-27T02:34:34.684Z level=DEBUG msg="Executing command" test=cdc-parity tool=conduit-s3-aa step=pre-test hook=wait-and-count-before-s3 command="/usr/bin/docker exec --interactive cdcparity-counter sh -c count() {\n  rm -rf /tmp/s3dump\n  aws --endpoint-url http://cdcparity-minio:9000 s3 cp --recursive s3://bench/ /tmp/s3dump --quiet 2>/dev/null || true\n  find /tmp/s3dump -type f -exec cat {} + 2>/dev/null | wc -l | tr -d ' '\n}\nn=0\nwhile [ \"$n\" -lt 180 ]; do\n  cnt=$(aws --endpoint-url http://cdcparity-minio:9000 s3api list-objects-v2 --bucket bench --max-keys 1 --query 'KeyCount' --output text 2>/dev/null || echo 0)\n  if [ \"${cnt:-0}\" -gt 0 ]; then break; fi\n  n=$((n+1))\n  sleep 1\ndone\nsleep 15\necho \"ROWS_BEFORE=$(count)\"\n"
