time=2026-10-27T02:53:45.205Z level=INFO msg="Running command in existing container" container=cdcparity-counter command="count() {\n  q=\"SELECT COALESCE(SUM(cnt),0)::bigint FROM (\"\n  i=0\n  while [ \"$i\" -lt \"${TABLES:-1}\" ]; do\n    if [ \"$i\" -gt 0 ]; then q=\"$q UNION ALL\"; fi\n    q=\"$q SELECT count(*) AS cnt FROM bench_dest_${i}\"\n    i=$((i+1))\n  done\n  q=\"$q) t\"\n  c=$(PGPASSWORD=bench psql -h cdcparity-postgres -U bench -d bench -tAc \"$q\" 2>/dev/null | tr -d ' ')\n  echo \"${c:-0}\"\n}\nn=0\nwhile [ \"$n\" -lt 180 ]; do\n  if [ \"$(count)\" -gt 0 ]; then break; fi\n  n=$((n+1))\n  sleep 1\ndone\nsleep 15\necho \"ROWS_BEFORE=$(count)\"\n"
