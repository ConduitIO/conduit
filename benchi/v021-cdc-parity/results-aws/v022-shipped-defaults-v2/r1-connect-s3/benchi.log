time=2026-10-27T02:59:36.794Z level=INFO msg="Running command in existing container" container=cdcparity-counter command="n=0\nuntil wget -q -O /dev/null http://cdcparity-connect-s3:8083/connectors 2>/dev/null; do\n  n=$((n+1))\n  if [ \"$n\" -ge 240 ]; then echo \"connect REST API never came up\"; exit 1; fi\n  sleep 1\ndone\n\nN=\"${TABLES:-1}\"\nfor i in $(seq 0 $((N-1))); do\n  t=\"bench_source_${i}\"\n  cat > /tmp/debezium-source-s3.json <<JSON\n{\"name\":\"debezium-s3-${i}\",\"config\":{\"connector.class\":\"io.debezium.connector.postgresql.PostgresConnector\",\"database.hostname\":\"cdcparity-postgres\",\"database.port\":\"5432\",\"database.user\":\"bench\",\"database.password\":\"bench\",\"database.dbname\":\"bench\",\"topic.prefix\":\"cdcparity\",\"table.include.list\":\"public.${t}\",\"plugin.name\":\"pgoutput\",\"slot.name\":\"debezium_slot_${i}\",\"publication.name\":\"debezium_pub_${i}\",\"publication.autocreate.mode\":\"filtered\",\"snapshot.mode\":\"never\",\"tombstones.on.delete\":\"false\",\"heartbeat.interval.ms\":\"0\",\"key.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"key.converter.schemas.enable\":\"false\",\"value.converter\":\"org.apache.kafka.connect.json.JsonConverter\",\"value.converter.schemas.enable\":\"false\"}}\nJSON\n  cat > /tmp/s3-sink.json <<JSON\n{\"name\":\"s3-sink-${i}\",\"config\":{\"connector.class\":\"io.confluent.connect.s3.S3SinkConnector\",\"tasks.max\":\"1\",\"topics\":\"cdcparity.public.${t}\",\"format.class\":\"io.confluent.connect.s3.format.json.JsonFormat\",\"flush.size\":\"1000\",\"rotate.interval.ms\":\"1000\",\"storage.class\":\"io.confluent.connect.s3.storage.S3Storage\",\"partitioner.class\":\"io.confluent.connect.storage.partitioner.DefaultPartitioner\",\"s3.bucket.name\":\"bench\",\"s3.region\":\"us-east-1\",\"store.url\":\"http://cdcparity-minio:9000\",\"path.style.access.enabled\":\"true\",\"aws.access.key.id\":\"conduitminio\",\"aws.secret.access.key\":\"conduitminiosecret\",\"schema.compatibility\":\"NONE\"}}\nJSON\n  wget -q -O- --header='Content-Type: application/json' --post-file=/tmp/debezium-source-s3.json http://cdcparity-connect-s3:8083/connectors\n  wget -q -O- --header='Content-Type: application/json' --post-file=/tmp/s3-sink.json http://cdcparity-connect-s3:8083/connectors\ndone\necho \"connect-s3 connectors registered (N=$N)\"\n"
