@@ -74,6 +74,17 @@ git worktree add -q --detach "$W/src-main" "$MAIN_SHA" || fail "worktree main"
 git worktree add -q --detach "$W/src-fanout" "$FANOUT_SHA" || fail "worktree fanout"
 git worktree add -q --detach "$W/src-harness" "$HARNESS_SHA" || fail "worktree harness"
 
+# Staged-engine prototype extension (see benchi/staged-engine-proto/README.md in
+# the prototype PR, which is the "fanout" PR here): add its shapes (4x4,
+# source-batched 1x1) to the harness checkout, and apply its bench-only
+# destination-latency hook to BOTH engine trees so every arm sees the same hook.
+SP="$W/src-fanout/benchi/staged-engine-proto"
+[ -d "$SP/shapes" ] || fail "prototype PR has no benchi/staged-engine-proto"
+cp -r "$SP/shapes/." "$W/src-harness/benchi/archv2-gate/shapes/" || fail "copy shapes"
+for t in src-main src-fanout; do
+  (cd "$W/$t" && git apply "$SP/patches/latency-injection.patch") || fail "apply latency hook to $t"
+done
+
 status "building images"
 docker build -q --label "org.opencontainers.image.revision=$MAIN_SHA" \
   -t conduit-bench:main "$W/src-main" || fail "docker build main"
@@ -104,6 +115,15 @@ WRAPDF
 docker build -q --label "org.opencontainers.image.revision=main ${MAIN_SHA} (v1 arms, arch-v2 forced) vs pr${FANOUT_PR} ${FANOUT_SHA} (v2 arm)" \
   -t conduit-bench:fanout "$W/fanout-wrap" || fail "docker build fanout wrapper"
 
+# Same images with the destination ack latency baked in as an environment
+# variable (the harness passes no env of its own).
+for lat in 1ms 10ms; do
+  for base in main fanout; do
+    printf 'FROM conduit-bench:%s\nENV CONDUIT_BENCH_DEST_ACK_LATENCY=%s\n' "$base" "$lat" \
+      | docker build -q -t "conduit-bench:${base}-lat${lat}" - || fail "docker build ${base}-lat${lat}"
+  done
+done
+
 cd "$W/src-harness" || fail "cd harness"
 go build -o "$W/archv2-gate" ./benchi/archv2-gate || fail "build harness"
 status "images and harness built"
