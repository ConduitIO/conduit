+// BENCH-ONLY: NOT part of any Conduit change. Lets the credit-window
+// sensitivity runs set the window from the environment.
+package funnel
+
+import (
+	"os"
+	"strconv"
+)
+
+func init() {
+	if v, err := strconv.ParseInt(os.Getenv("CONDUIT_BENCH_CREDIT_RECORDS"), 10, 64); err == nil && v > 0 {
+		defaultCreditRecords = v
+	}
+	if v, err := strconv.Atoi(os.Getenv("CONDUIT_BENCH_UNACKED_RECORDS")); err == nil && v > 0 {
+		maxUnackedRecords = v
+	}
+}
