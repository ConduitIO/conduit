diff --git a/pkg/lifecycle-poc/funnel/zz_profile_stats.go b/pkg/lifecycle-poc/funnel/zz_profile_stats.go
new file mode 100644
index 00000000..bebf2d82
--- /dev/null
+++ b/pkg/lifecycle-poc/funnel/zz_profile_stats.go
@@ -0,0 +1,74 @@
+// PROFILING-ONLY instrumentation. Not part of any PR.
+package funnel
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type stageStat struct {
+	n, ns, max atomic.Int64
+}
+
+var stageStats sync.Map
+
+func stageAdd(name string, d time.Duration) {
+	v, ok := stageStats.Load(name)
+	if !ok {
+		v, _ = stageStats.LoadOrStore(name, &stageStat{})
+	}
+	s := v.(*stageStat)
+	s.n.Add(1)
+	s.ns.Add(int64(d))
+	for {
+		m := s.max.Load()
+		if int64(d) <= m || s.max.CompareAndSwap(m, int64(d)) {
+			break
+		}
+	}
+}
+
+func stageStart() time.Time { return time.Now() }
+func stageEnd(name string, t time.Time) { stageAdd(name, time.Since(t)) }
+
+// DumpStageStats writes the table to w.
+func DumpStageStats(w io.Writer) {
+	type row struct {
+		name      string
+		n, ns, mx int64
+	}
+	var rows []row
+	stageStats.Range(func(k, v any) bool {
+		s := v.(*stageStat)
+		rows = append(rows, row{k.(string), s.n.Load(), s.ns.Load(), s.max.Load()})
+		return true
+	})
+	sort.Slice(rows, func(i, j int) bool { return rows[i].name < rows[j].name })
+	fmt.Fprintf(w, "%-28s %12s %14s %12s %12s\n", "stage", "calls", "total_ms", "mean_us", "max_us")
+	for _, r := range rows {
+		mean := float64(0)
+		if r.n > 0 {
+			mean = float64(r.ns) / float64(r.n) / 1e3
+		}
+		fmt.Fprintf(w, "%-28s %12d %14.1f %12.2f %12.1f\n", r.name, r.n, float64(r.ns)/1e6, mean, float64(r.mx)/1e3)
+	}
+}
+
+// DumpStageStatsToEnvFile dumps to $CONDUIT_STAGE_STATS if set.
+func DumpStageStatsToEnvFile() {
+	p := os.Getenv("CONDUIT_STAGE_STATS")
+	if p == "" {
+		return
+	}
+	f, err := os.Create(p)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	DumpStageStats(f)
+}
