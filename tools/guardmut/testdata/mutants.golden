// log-call
package fx

import "errors"

func Check(n int) error {
	// guard: neg-input
	if n < 0 {
		return errors.New("negative")
	}
	// guard: log-call
	_ = func() { note(n) }
	return nil
}

func note(int) {}
// neg-input
package fx

import "errors"

func Check(n int) error {
	// guard: neg-input
	if false && (n < 0) {
		return errors.New("negative")
	}
	// guard: log-call
	note(n)
	return nil
}

func note(int) {}
